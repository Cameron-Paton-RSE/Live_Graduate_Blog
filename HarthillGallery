  ];

  let current = 0;
  const mainImg = document.getElementById('mainImg');
  const counterNum = document.getElementById('counterNum');
  const progress = document.getElementById('progress');
  const strip = document.getElementById('thumbStrip');
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');

  function goTo(n) {
    current = (n + imgs.length) % imgs.length;
    counterNum.textContent = current + 1;
    progress.style.width = ((current + 1) / imgs.length * 100) + '%';
    mainImg.classList.add('loading');
    mainImg.src = imgs[current];
    document.querySelectorAll('.thumb').forEach((t, i) => t.classList.toggle('active', i === current));
    const activeThumb = strip.children[current];
    if (activeThumb) activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  mainImg.onload = () => mainImg.classList.remove('loading');

  document.getElementById('prevBtn').onclick = (e) => { e.stopPropagation(); goTo(current - 1); };
  document.getElementById('nextBtn').onclick = (e) => { e.stopPropagation(); goTo(current + 1); };

  document.getElementById('stage').onclick = () => {
    lightboxImg.src = imgs[current];
    lightbox.classList.add('open');
  };

  lightbox.onclick = () => lightbox.classList.remove('open');
  document.getElementById('lightboxClose').onclick = () => lightbox.classList.remove('open');

  document.addEventListener('keydown', e => {
    if (lightbox.classList.contains('open')) { if (e.key === 'Escape') lightbox.classList.remove('open'); return; }
    if (e.key === 'ArrowLeft') goTo(current - 1);
    if (e.key === 'ArrowRight') goTo(current + 1);
  });

  imgs.forEach((src, i) => {
    const t = document.createElement('img');
    t.className = 'thumb' + (i === 0 ? ' active' : '');
    t.src = src;
    t.alt = 'Photo ' + (i + 1);
    t.onclick = () => goTo(i);
    strip.appendChild(t);
  });

  goTo(0);
</script>
